# ==============================================================================
# SourceLens YouTube Evidence Lab - Environment Configuration
# Copy this file to .env.local and fill in your keys.
# ==============================================================================

# AI Summarization & Speech-to-Text Providers
# (Add any one of OPENAI_API_KEY, GEMINI_API_KEY, or GROQ_API_KEY)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (Alternative)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Groq (Alternative)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# YouTube Data API v3 (for high-volume tag extraction & video details)
YOUTUBE_API_KEY=your_youtube_api_key_here

